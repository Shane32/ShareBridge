<Window
    x:Class="ShareBridge.App.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Share Bridge – Error">

    <Grid Padding="32" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Share Bridge encountered an error"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

        <!-- Error message -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ErrorMessageText"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"/>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button x:Name="OpenLogFolderButton"
                    Content="Open Log Folder"
                    Click="OpenLogFolderButton_Click"/>
            <Button x:Name="CloseButton"
                    Content="Close"
                    Click="CloseButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </StackPanel>

    </Grid>
</Window>
